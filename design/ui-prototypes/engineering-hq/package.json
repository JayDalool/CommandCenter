{
  "name": "commandcenter-engineering-hq-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ISOLATED design prototype of the Engineering HQ UI. Mock data only; talks to no ccd, no backend, no production.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181 --strictPort",
    "review": "npm run build && vite preview --host 127.0.0.1 --port 5181 --strictPort --open",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "qa": "node e2e/qa.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
