*.pyc
*.db
*.db-wal
*.db-shm
*.log
*.log.*
*.sock
*.token
state/
.env
.env.*
config.json
!server/config.example.json
node_modules/
dist/
*.tsbuildinfo
/launcher/launcher
/launcher/*.exe
