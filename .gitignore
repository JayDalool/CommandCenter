# Never commit runtime state, credentials or machine-local files.
.venv/
__pycache__/
*.pyc
*.db
*.db-wal
*.db-shm
*.log
*.log.*
*.sock
*.token
state/
.env
.env.*
config.json
!server/config.example.json
node_modules
dist/
*.tsbuildinfo
/launcher/launcher
/launcher/*.exe
# Claude Code: agent worktrees and personal settings are machine-local.
.claude/worktrees/
.claude/settings.local.json
# Browser tests (web/app/e2e): reports, traces and the parity screenshots each run takes. Never committed.
web/app/playwright-report*/
web/app/test-results*/
web/app/e2e/.parity/
