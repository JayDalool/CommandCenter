# PROPOSAL — not installed. Runs the herdr server under systemd --user (the same
# manager as ccd, with Linger=yes) so it survives SSH disconnects. On 2026-10-02
# 23:41:59 herdr shut down right after Jay's SSH session ended, taking every
# Claude pane with it. Jay installs this only after reading it:
#   cp scripts/herdr.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now herdr && herdr status
# Attach from anywhere with `herdr` (or `ssh -t jay-server herdr` from Windows).
[Unit]
Description=herdr terminal workspace server (owns the Claude panes)
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr server
Restart=on-failure
RestartSec=5
# Panes are login shells; give them a sane terminal.
Environment=TERM=xterm-256color

[Install]
WantedBy=default.target
