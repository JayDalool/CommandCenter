#!/usr/bin/env python3
"""cc-terminal — what a native Windows Terminal tab runs on jay-server.

CommandCenter.exe opens `ssh -t jay-server -- <this file> <action> <PREFIX>`.
The Windows side only ever names an action and a project PREFIX; everything
else — the path, the coordinator, the command — is resolved here, on the
server, from the one project registry (server/ccd/registry.py).

    cc-terminal repo <PREFIX>     cd <registered root> && exec <login shell> -l
    cc-terminal claude <PREFIX>   exec herdr agent attach <the coordinator's pane>
    cc-terminal task <KEY>        exec herdr agent attach <the ticket's task Claude session (sv-071)>
    cc-terminal --dry-run …       print what it would run, run nothing

`claude` attaches to the coordinator herdr already runs. It never starts,
resumes or restarts a Claude session: no coordinator means a clear message and
nothing else. Which Claude is the coordinator is decided by the one shared
resolver, server/ccd/coordid.py (also used by ccd for the browser terminal,
the Workspace and the Agents page): a recorded session binding, else a herdr
label or title naming the coordinator at the registered root. An unnamed Claude
at the root must first be adopted in Command Center; several are never guessed.

Anything not matching exactly is refused. No argument becomes a path or a
command.
"""
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import termios
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "server"))

from ccd import coordid, registry  # noqa: E402

PREFIX_RE = re.compile(r"^[A-Z][A-Z0-9]{1,5}$")
KEY_RE = re.compile(r"^([A-Z][A-Z0-9]{0,8}(?:-[A-Z0-9]{1,8})?)-([0-9]{1,6})$")
# `ssh host cmd` gets a non-login PATH; herdr lives in ~/.local/bin, so find it explicitly.
# Absolute: the exec happens after chdir, so a relative PATH entry must not be left relative.
HERDR = os.path.abspath(shutil.which("herdr") or os.path.expanduser("~/.local/bin/herdr"))


class Refused(Exception):
    pass


def project_for(prefix):
    """(key, root) for a live registry prefix, else Refused."""
    if not isinstance(prefix, str) or not PREFIX_RE.match(prefix):
        raise Refused("project must be a registered prefix such as SV, GZ, MFE, CC or GYST")
    for key, p in registry.PROJECTS.items():
        if p["prefix"] == prefix:
            root = p.get("root")
            if not root or not os.path.isdir(root):
                raise Refused(f"{prefix}: the registered checkout {root} is not on this server")
            return key, os.path.realpath(root)
    raise Refused(f"{prefix} is not a registered project")


def coordinator_pane(key, root, agents):
    """The pane of `key`'s coordinator, via the one shared resolver (ccd/coordid.py)."""
    r = coordid.resolve_and_record(key, root, agents)
    if r["state"] == "ready":
        return r["paneId"]
    if r["state"] == "found":
        raise Refused(f"a Claude is running in {root} but is not yet this project's coordinator. "
                      f"Adopt it in Command Center (Workspace → Claude → Adopt), then open this terminal again.")
    if r["state"] == "multiple":
        raise Refused(f"{len(r['candidates'])} Claude sessions are running in {root}; choose one in "
                      f"Command Center (Workspace → Claude), then open this terminal again.")
    raise Refused(f"no Claude is running in {root}. Command Center never starts one; "
                  f"start it in herdr, then open this terminal again.")


def herdr_agents(run=subprocess.run):
    out = run([HERDR, "agent", "list"], capture_output=True, text=True, timeout=10, check=False)
    try:
        data = json.loads(out.stdout or "{}")
    except ValueError:
        raise Refused("herdr did not answer `agent list`; is herdr running?")
    return ((data.get("result") or {}).get("agents")) or []


def task_pane(key, agents):
    r = coordid.task_session(key, agents)
    if r["state"] == "ready":
        return r["paneId"]
    if r["state"] == "multiple":
        raise Refused(f"{len(r['candidates'])} Claude sessions are named {key.lower()}; close the extra one in herdr.")
    raise Refused(f"no Claude task session for {key} is running (it is named {key.lower()}). Command Center never "
                  f"starts one; ask the project coordinator to start it, then open this terminal again.")


def plan(argv, agents_fn=herdr_agents):
    """(executable, args, cwd, title) for the request, or Refused. Pure apart from agents_fn."""
    if len(argv) == 2 and argv[0] == "task":
        key = argv[1]
        m = KEY_RE.match(key) if isinstance(key, str) else None
        if not m:
            raise Refused("task must be a ticket key such as SV-071")
        found = registry.resolve_prefix(m.group(1))
        if not found:
            raise Refused(f"{m.group(1)} is not a registered ticket prefix")
        _, root = project_for(registry.prefix_of(found[1]))
        return HERDR, ["herdr", "agent", "attach", task_pane(key, agents_fn())], root, f"Claude — {key}"
    if len(argv) != 2 or argv[0] not in ("repo", "claude"):
        raise Refused("usage: cc-terminal repo|claude <PREFIX> · cc-terminal task <KEY>")
    action, prefix = argv
    key, root = project_for(prefix)
    name = registry.name_of(key)
    if action == "repo":
        shell = pwd.getpwuid(os.getuid()).pw_shell or "/bin/bash"
        return shell, [os.path.basename(shell), "-l"], root, f"Repo — {name}"
    pane = coordinator_pane(key, root, agents_fn())
    return HERDR, ["herdr", "agent", "attach", pane], root, f"Claude — {name}"


def main(argv):
    dry = argv[:1] == ["--dry-run"]
    if dry:
        argv = argv[1:]
    try:
        exe, args, cwd, title = plan(argv)
        if dry:
            print(json.dumps({"exe": exe, "args": args, "cwd": cwd, "title": title}))
            return 0
    except Refused as e:
        sys.stderr.write(f"\n  Command Center: {e}\n\n")
        if sys.stdin.isatty() and not os.environ.get("CC_TERMINAL_NONINTERACTIVE"):
            try:
                input("  Press Enter to close. ")
            except EOFError:
                pass
        return 2
    sys.stdout.write(f"\x1b]0;{title}\x07")
    sys.stdout.flush()
    if argv[0] in ("claude", "task") and sys.stdin.isatty():
        # Keys typed while the tab was opening (e.g. Enter after a browser prompt) must not
        # land in a live Claude pane: drop anything already queued before attaching.
        time.sleep(0.3)
        termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
    os.chdir(cwd)
    os.execv(exe, args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
